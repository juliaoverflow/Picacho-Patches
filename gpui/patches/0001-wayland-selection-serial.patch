Wayland: set the clipboard and primary selection with the serial of the latest key press or mouse button, so a copy made by clicking is not ignored.

diff --git a/src/platform/linux/wayland/client.rs b/src/platform/linux/wayland/client.rs
index 1ebdda3..4a2b2f7 100644
--- a/src/platform/linux/wayland/client.rs
+++ b/src/platform/linux/wayland/client.rs
@@ -809,7 +809,12 @@ impl LinuxClient for WaylandClient {
         };
         if state.mouse_focused_window.is_some() || state.keyboard_focused_window.is_some() {
             state.clipboard.set_primary(item);
-            let serial = state.serial_tracker.get(SerialKind::KeyPress);
+            // The input that asked for the copy: a key press, or a click
+            // (a context menu's Copy). Compositors refuse a selection set
+            // with a serial older than the current one's.
+            let serial = state
+                .serial_tracker
+                .latest(&[SerialKind::KeyPress, SerialKind::MousePress]);
             let data_source = primary_selection_manager.create_source(&state.globals.qh, ());
             for mime_type in TEXT_MIME_TYPES {
                 data_source.offer(mime_type.to_string());
