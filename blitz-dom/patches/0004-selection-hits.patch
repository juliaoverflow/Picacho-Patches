Hit testing an inline root's boxes and text where they are painted.

diff --git a/src/document.rs b/src/document.rs
index e41dc0c..b8fd12c 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -2507,7 +2507,20 @@ impl BaseDocument {
