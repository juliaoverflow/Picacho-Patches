 gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.12", features = ["font-kit"] }
-wgpu = "29.0.4"
+# The same wgpu as gpui-pre-wgpu, whose context takes this crate's instance and surface.
+wgpu = "30.0.1"
 
 # Text / font stack
 pathfinder_geometry = "0.5"
