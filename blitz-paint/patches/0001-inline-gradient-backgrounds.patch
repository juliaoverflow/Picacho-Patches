+
+/// The color of the topmost background layer when it is a linear or radial
+/// gradient of a single opaque color (as in `linear-gradient(c, c)`), which
+/// paints exactly that color over everything below it.
+fn solid_gradient_color(
+    style: &style::properties::ComputedValues,
+    current_color: &style::color::AbsoluteColor,
+) -> Option<Color> {
+    use style::values::generics::image::{GenericGradient, GenericGradientItem};
+    let top = style.get_background().background_image.0.first()?;
+    let GenericImage::Gradient(gradient) = top else {
+        return None;
+    };
+    let colors: Vec<Color> = match &**gradient {
+        GenericGradient::Linear { items, .. } | GenericGradient::Radial { items, .. } => items
+            .iter()
+            .filter_map(|item| match item {
+                GenericGradientItem::SimpleColorStop(color)
+                | GenericGradientItem::ComplexColorStop { color, .. } => {
+                    Some(color.resolve_to_absolute(current_color).as_srgb_color())
+                }
+                GenericGradientItem::InterpolationHint(_) => None,
+            })
+            .collect(),
+        GenericGradient::Conic { .. } => return None,
+    };
+    let first = *colors.first()?;
+    (first.components[3] >= 1.0 && colors.iter().all(|c| *c == first)).then_some(first)
+}
