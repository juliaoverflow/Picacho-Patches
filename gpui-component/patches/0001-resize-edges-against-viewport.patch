+/// The window edge under `pos`, if any. Measured against the drawn surface
+/// (`size` is the viewport), never the window's restore bounds: while the
+/// window is maximized those are smaller than the surface, and the lower and
+/// right part of the content would count as a resize edge. Tiled edges have no
+/// shadow to grab and cannot be resized.
+fn resize_edge(
+    pos: Point<Pixels>,
+    shadow_size: Pixels,
+    size: Size<Pixels>,
+    tiling: Tiling,
+) -> Option<ResizeEdge> {
+    let top = !tiling.top && pos.y < shadow_size;
+    let bottom = !tiling.bottom && pos.y > size.height - shadow_size;
+    let left = !tiling.left && pos.x < shadow_size;
+    let right = !tiling.right && pos.x > size.width - shadow_size;
+    let edge = match (top, bottom, left, right) {
+        (true, _, true, _) => ResizeEdge::TopLeft,
+        (true, _, _, true) => ResizeEdge::TopRight,
+        (true, _, _, _) => ResizeEdge::Top,
+        (_, true, true, _) => ResizeEdge::BottomLeft,
+        (_, true, _, true) => ResizeEdge::BottomRight,
+        (_, true, _, _) => ResizeEdge::Bottom,
+        (_, _, true, _) => ResizeEdge::Left,
+        (_, _, _, true) => ResizeEdge::Right,
+        _ => return None,
     };
     Some(edge)
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::size;
+
+    #[test]
+    fn content_of_a_maximized_window_is_no_edge() {
+        let tiled = Tiling::tiled();
+        let s = size(px(1920.), px(1080.));
+        assert_eq!(resize_edge(point(px(960.), px(1075.)), px(12.), s, tiled), None);
+        assert_eq!(resize_edge(point(px(1915.), px(5.)), px(12.), s, tiled), None);
+    }
+
+    #[test]
+    fn shadow_of_a_floating_window_is_an_edge() {
+        let s = size(px(800.), px(600.));
+        let free = Tiling::default();
+        assert_eq!(resize_edge(point(px(400.), px(300.)), px(12.), s, free), None);
+        assert_eq!(
+            resize_edge(point(px(400.), px(595.)), px(12.), s, free),
+            Some(ResizeEdge::Bottom)
+        );
+        assert_eq!(
+            resize_edge(point(px(795.), px(595.)), px(12.), s, free),
+            Some(ResizeEdge::BottomRight)
+        );
+    }
